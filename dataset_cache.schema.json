{
    "version": "1.0",
    "description": "Single-file cache for walk-based transformer datasets.",
    "keys": {
        "version": "string",
        "walks": "List[List[str]]",
        "tokenizer": {
            "token2id": "Dict[str,int]",
            "id2token": "Dict[int,str]",
            "edge_label2id": "Dict[str,int]",
            "id2edge_label": "Dict[int,str]",
            "PAD_ID": "int",
            "MASK_ID": "int",
            "UNK_ID": "int",
            "UNK_LABEL_ID": "int",
            "vocab_size": "int",
            "num_edge_tokens": "int"
        },
        "encoded": {
            "input_ids": "Tensor[int64] shape [num_walks, max_len]",
            "edge_split_mask": "Tensor[int64] shape [num_walks, max_len]",
            "attention_base": "Tensor[int64] shape [num_walks, max_len]"
        },
        "splits": {
            "train": "List[Tuple[int,int,int]]",
            "mask": "List[Tuple[int,int,int]]",
            "val": "List[Tuple[int,int,int]]",
            "test": "List[Tuple[int,int,int]]"
        },
        "metadata": {
            "vocab_size": "int",
            "num_classes": "int",
            "pad_id": "int",
            "ignore_index": "int",
            "class_weights": "List[float]",
            "dataset_name": "string",
            "seed": "int"
        }
    }
}
